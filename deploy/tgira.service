[Unit]
Description=tgira task tracker bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tgira
Group=tgira
WorkingDirectory=/opt/tgira
ExecStart=/opt/tgira/tgira -config /etc/tgira/config.yaml
EnvironmentFile=/etc/tgira/tgira.env
Restart=always
RestartSec=5

# The bot needs nothing but its own database.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tgira
MemoryMax=192M

[Install]
WantedBy=multi-user.target
